# Copy this file to .env in the same folder (backend/.env) and fill in your keys.
# backend/.env is gitignored.

# --- Groq (default provider in ai_engine) ---
GROQ_ENABLED=true
# Paste your key from https://console.groq.com/keys — starts with gsk_
GROQ_API_KEY=

# --- Optional: other providers (set GROQ_ENABLED=false to use one) ---
OPENAI_ENABLED=false
OPENAI_API_KEY=

GEMINI_ENABLED=false
GEMINI_API_KEY=

LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
