# ─────────────────────────────────────────────────────────────────────
# COGNIXAR — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────
# 1. Copy this file to `.env` in the same directory (backend/.env)
# 2. Replace the placeholder below with your actual Groq API key
# 3. backend/.env is gitignored — your real key will never be committed
#
# Get a free Groq API key: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────────

# Groq API key (required) — must start with "gsk_"
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Optional: override the port uvicorn binds to (defaults to 8000)
# PORT=8000
